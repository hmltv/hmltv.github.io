<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.meinname" name="Mein Privates Kodi Repo" version="1.0.0" provider-name="DeinName">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Mein Privates Kodi Repo">
        <dir>
            <info compressed="false">https://github.io</info>
            <checksum>https://github.io.md5</checksum>
            <datadir zip="true">https://github.io</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="de">Automatisches Update-Repo für xStream und Vavoo</summary>
        <description lang="de">Dieses Repository hält xStream und Vavoo auf all meinen Geräten aktuell.</description>
        <platform>all</platform>
    </extension>
</addon>
